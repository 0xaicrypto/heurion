# syntax=docker/dockerfile:1.6
#
# Heurion base image — Python 3.11 + Node 22 + uv + nexus user.
#
# Built on schedule (weekly) and when this file changes, pushed to GHCR.
# Main Dockerfile and Dockerfile.worker derive from this so they skip
# the expensive Node / uv install on every build.

FROM python:3.11-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive

# Node 22 LTS (required for MCP installs + lobehub/market-cli at runtime)
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates gnupg \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && apt-get purge -y --auto-remove gnupg \
 && rm -rf /var/lib/apt/lists/* \
 && node --version && npm --version

# uv — fastest Python package installer
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install uv==0.4.30

# Non-root user for volume mounts
RUN useradd --create-home --uid 1000 --shell /bin/bash nexus
