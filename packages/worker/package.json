{
  "name": "heurion-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Heurion execution plane — document rendering, plugin execution, job processing",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "node -r ./scripts/eslint-ts-patch.cjs ./node_modules/eslint/bin/eslint.js src --ext .ts --report-unused-disable-directives --max-warnings 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.500.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@heurion/contracts": "file:../contracts",
    "@heurion/ssrf-guard": "file:../ssrf-guard",
    "docx": "^9.7.1",
    "fastify": "^4.0.0",
    "pdfkit": "^0.19.1",
    "pptxgenjs": "^3.12.0",
    "puppeteer-core": "^23.11.1",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^9.0.0",
    "jszip": "^3.10.2",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "typescript-lint": "npm:typescript@5.9.3"
  }
}
