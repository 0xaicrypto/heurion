[
  {
    "manifest_version": "1.0.0",
    "plugin": {
      "id": "heurion/docx",
      "name": "DOCX Report Generator",
      "version": "1.0.0",
      "description": "Generate Word documents from clinical summaries, case summaries, and discharge notes.",
      "category": "execution",
      "author": {
        "name": "Heurion",
        "email": "plugins@heurion.io"
      },
      "license": "MIT",
      "tags": [
        "report",
        "docx",
        "document"
      ]
    },
    "runtime": {
      "type": "container",
      "image": "heurion/plugin-docx:1.0.0",
      "port": 8080,
      "resources": {
        "cpu": "1",
        "memory": "512m",
        "max_execution_seconds": 60
      }
    },
    "permissions": {
      "network_egress": {
        "enabled": false
      },
      "file_system": {
        "read": true,
        "write": true,
        "paths": [
          "/workspace",
          "/tmp"
        ]
      },
      "phi_access": false,
      "execute_code": false
    },
    "tools": [
      {
        "name": "generate_docx",
        "description": "Generate a Word document from a template and structured data.",
        "parameters": {
          "type": "object",
          "properties": {
            "template_id": {
              "type": "string"
            },
            "data": {
              "type": "object"
            },
            "output_name": {
              "type": "string"
            }
          },
          "required": [
            "template_id",
            "data"
          ]
        }
      }
    ],
    "triggers": [
      {
        "intent": "docx",
        "patterns": [
          "docx",
          "word",
          "病例总结",
          "出院小结",
          "discharge summary"
        ]
      }
    ]
  },
