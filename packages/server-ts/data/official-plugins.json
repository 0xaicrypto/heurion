[
  {
    "manifest_version": "1.0.0",
    "plugin": {
      "id": "heurion/docx",
      "name": "DOCX Report Generator",
      "version": "1.0.0",
      "description": "Generate Word documents from clinical summaries, case summaries, and discharge notes.",
      "category": "execution",
      "author": { "name": "Heurion", "email": "plugins@heurion.io" },
      "license": "MIT",
      "tags": ["report", "docx", "document"]
    },
    "runtime": {
      "type": "container",
      "image": "heurion/plugin-docx:1.0.0",
      "port": 8080,
      "resources": { "cpu": "1", "memory": "512m", "max_execution_seconds": 60 }
    },
    "permissions": {
      "network_egress": { "enabled": false },
      "file_system": { "read": true, "write": true, "paths": ["/workspace", "/tmp"] },
      "phi_access": false,
      "execute_code": false
    },
    "tools": [
      {
        "name": "generate_docx",
        "description": "Generate a Word document from a template and structured data.",
        "parameters": {
          "type": "object",
          "properties": {
            "template_id": { "type": "string" },
            "data": { "type": "object" },
            "output_name": { "type": "string" }
          },
          "required": ["template_id", "data"]
        }
      }
    ],
    "triggers": [
      { "intent": "docx", "patterns": ["docx", "word", "病例总结", "出院小结", "discharge summary"] }
    ]
  },
  {
    "manifest_version": "1.0.0",
    "plugin": {
      "id": "heurion/pptx",
      "name": "PPTX Presentation Generator",
      "version": "1.0.0",
      "description": "Generate academic or clinical PowerPoint presentations.",
      "category": "execution",
      "author": { "name": "Heurion", "email": "plugins@heurion.io" },
      "license": "MIT",
      "tags": ["report", "pptx", "presentation"]
    },
    "runtime": {
      "type": "container",
      "image": "heurion/plugin-pptx:1.0.0",
      "port": 8080,
      "resources": { "cpu": "1", "memory": "512m", "max_execution_seconds": 60 }
    },
    "permissions": {
      "network_egress": { "enabled": false },
      "file_system": { "read": true, "write": true, "paths": ["/workspace", "/tmp"] },
      "phi_access": false,
      "execute_code": false
    },
    "tools": [
      {
        "name": "generate_pptx",
        "description": "Generate a PowerPoint presentation from a template and structured data.",
        "parameters": {
          "type": "object",
          "properties": {
            "template_id": { "type": "string" },
            "data": { "type": "object" },
            "output_name": { "type": "string" }
          },
          "required": ["template_id", "data"]
        }
      }
    ],
    "triggers": [
      { "intent": "pptx", "patterns": ["pptx", "ppt", "powerpoint", "幻灯片", "汇报", "presentation"] }
    ]
  },
  {
    "manifest_version": "1.0.0",
    "plugin": {
      "id": "heurion/table",
      "name": "Medical Table Renderer",
      "version": "1.0.0",
      "description": "Render Table 1, baseline characteristics, and adverse-event summaries.",
      "category": "execution",
      "author": { "name": "Heurion", "email": "plugins@heurion.io" },
      "license": "MIT",
      "tags": ["report", "table", "docx"]
    },
    "runtime": {
      "type": "container",
      "image": "heurion/plugin-table:1.0.0",
      "port": 8080,
      "resources": { "cpu": "1", "memory": "512m", "max_execution_seconds": 60 }
    },
    "permissions": {
      "network_egress": { "enabled": false },
      "file_system": { "read": true, "write": true, "paths": ["/workspace", "/tmp"] },
      "phi_access": false,
      "execute_code": false
    },
    "tools": [
      {
        "name": "render_table",
        "description": "Render a medical table as a DOCX file.",
        "parameters": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "headers": { "type": "array" },
            "rows": { "type": "array" },
            "output_name": { "type": "string" }
          },
          "required": ["title", "headers", "rows"]
        }
      }
    ],
    "triggers": [
      { "intent": "table", "patterns": ["table", "表格", "基线特征", "baseline", "table 1"] }
    ]
  },
  {
    "manifest_version": "1.0.0",
    "plugin": {
      "id": "heurion/plot",
      "name": "Medical Plot Renderer",
      "version": "1.0.0",
      "description": "Render KM curves, bar charts, line charts, and forest plots.",
      "category": "execution",
      "author": { "name": "Heurion", "email": "plugins@heurion.io" },
      "license": "MIT",
      "tags": ["report", "plot", "chart"]
    },
    "runtime": {
      "type": "container",
      "image": "heurion/plugin-plot:1.0.0",
      "port": 8080,
      "resources": { "cpu": "1", "memory": "512m", "max_execution_seconds": 60 }
    },
    "permissions": {
      "network_egress": { "enabled": false },
      "file_system": { "read": true, "write": true, "paths": ["/workspace", "/tmp"] },
      "phi_access": false,
      "execute_code": false
    },
    "tools": [
      {
        "name": "render_plot",
        "description": "Render a statistical plot as PNG.",
        "parameters": {
          "type": "object",
          "properties": {
            "plot_type": { "type": "string" },
            "title": { "type": "string" },
            "x_label": { "type": "string" },
            "y_label": { "type": "string" },
            "series": { "type": "array" },
            "output_name": { "type": "string" }
          },
          "required": ["plot_type", "series"]
        }
      }
    ],
    "triggers": [
      { "intent": "plot", "patterns": ["plot", "chart", "graph", "图表", "曲线", "km curve", "forest plot"] }
    ]
  },
  {
    "manifest_version": "1.0.0",
    "plugin": {
      "id": "heurion/pdf",
      "name": "PDF Converter",
      "version": "1.0.0",
      "description": "Convert DOCX or PPTX files to PDF.",
      "category": "execution",
      "author": { "name": "Heurion", "email": "plugins@heurion.io" },
      "license": "MIT",
      "tags": ["report", "pdf", "convert"]
    },
    "runtime": {
      "type": "container",
      "image": "heurion/plugin-pdf:1.0.0",
      "port": 8080,
      "resources": { "cpu": "1", "memory": "512m", "max_execution_seconds": 120 }
    },
    "permissions": {
      "network_egress": { "enabled": false },
      "file_system": { "read": true, "write": true, "paths": ["/workspace", "/tmp"] },
      "phi_access": false,
      "execute_code": false
    },
    "tools": [
      {
        "name": "convert_to_pdf",
        "description": "Convert a DOCX or PPTX file to PDF.",
        "parameters": {
          "type": "object",
          "properties": {
            "source_file_id": { "type": "string" },
            "output_name": { "type": "string" }
          },
          "required": ["source_file_id"]
        }
      }
    ],
    "triggers": [
      { "intent": "pdf", "patterns": ["pdf", "convert to pdf", "导出 pdf"] }
    ]
  }
]
