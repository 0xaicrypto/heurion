        "parameters": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "data": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "template": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "elements": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "required": [
            "type",
            "title"
          ]
        },
        "returns": {
          "type": "object",
          "properties": {
            "file_id": {
              "type": "string"
            },
            "url": {
              "type": "string"
            },
            "markdown": {
              "type": "string"
            }
          }
        }
      }
    ],
    "settings": {
      "schema": {
        "type": "object",
        "properties": {}
      }
    }
  }
