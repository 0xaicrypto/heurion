DATABASE_URL="file:./nexus_server.db"
SERVER_PORT=8001
SERVER_SECRET=dev-secret-key
DEEPSEEK_API_KEY=sk-your-key
CORS_ALLOW_ORIGINS=http://localhost:5173
TWIN_BASE_DIR=.nexus/twins

# Embedding service configuration (#19). Defaults to a local bge-m3 service at
# http://localhost:8003/embed. Set EMBEDDING_PROVIDER=openai to use OpenAI
# directly, or EMBEDDING_FALLBACK_PROVIDER=openai to fall back on local failure.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUANTIZATION=none
EMBEDDING_DIMENSIONS=1024
EMBEDDING_FALLBACK_PROVIDER=none
LOCAL_EMBEDDING_URL=http://localhost:8003/embed
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: connect to a local Execution Plane (Sidecar worker). If omitted,
# sidecar render calls fall back to an in-memory stub.
EXECUTION_PLANE_URL=http://localhost:8002
WORKER_API_TOKEN=dev-worker-token

# Plugin settings encryption key (32+ bytes recommended; derived to 256-bit key).
# In production this must be set explicitly and kept secret.
PLUGIN_ENCRYPTION_KEY=dev-plugin-encryption-key-change-me
