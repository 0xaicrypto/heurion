DATABASE_URL="file:./nexus_server.db"
SERVER_PORT=8001
SERVER_SECRET=dev-secret-key
DEEPSEEK_API_KEY=sk-your-key
CORS_ALLOW_ORIGINS=http://localhost:5173
TWIN_BASE_DIR=.nexus/twins

# Optional: connect to a local Execution Plane (Sidecar worker). If omitted,
# sidecar render calls fall back to an in-memory stub.
EXECUTION_PLANE_URL=http://localhost:8002
WORKER_API_TOKEN=dev-worker-token

# Plugin settings encryption key (32+ bytes recommended; derived to 256-bit key).
# In production this must be set explicitly and kept secret.
PLUGIN_ENCRYPTION_KEY=dev-plugin-encryption-key-change-me
