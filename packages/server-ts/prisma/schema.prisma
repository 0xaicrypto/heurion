generator client {
  provider = "prisma-client-js"
  // Ship both engine binaries — the Docker runtime openssl flavor can vary
  // across base images (observed: generated for 1.1.x, runtime required
  // 3.0.x). "native" covers local dev.
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id
  displayName     String    @unique @map("display_name")
  passwordHash    String?   @map("password_hash")
  role            String    @default("user")
  status          String    @default("approved")
  // #284: unique identity fields — email is verified, phone is storage-only.
  email           String?   @unique
  emailVerified   Int       @default(0) @map("email_verified")
  phone           String?   @unique
  organization    String?
  intendedUse     String?   @map("intended_use")
  isAdmin         Int       @default(0) @map("is_admin")
  tier            String    @default("beta")
  stripeCustomerId String?  @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")
  subscriptionState String? @map("subscription_state")
  trialEndsAt      String?  @map("trial_ends_at")
  disabledAt       String?  @map("disabled_at")
  lastLoginAt      String?  @map("last_login_at")
  avatarEmoji      String?  @default("🩺") @map("avatar_emoji")
  deletedAt        String?  @map("deleted_at")
  createdAt        String   @map("created_at")
  updatedAt        String   @map("updated_at")

  sessions      Session[]
  docs          Doc[]
  skillPrefs    UserSkillPref[]
  settings      UserSetting[]
  chatTakeaways ChatTakeaway[]
  taskPlans     TaskPlan[]
  figureRenders FigureRender[]
  studies       ResearchStudy[]
  patients      PatientRecord[]
   knowledgeGaps KnowledgeGap[]
   telemetryEvents TelemetryEvent[]
   pluginInstallations PluginInstallation[]
   externalUserMappings ExternalUserMapping[]
   medicalRecordEntries MedicalRecordEntry[]
  approvalRequests ApprovalRequest[]
  fileIndexes      FileIndex[]
  pipelineJobs     FilePipelineJob[]
  @@map("users")
}

model Session {
  id             String   @id
  userId         String   @map("user_id")
  title          String
  scope          String   @default("global") // 'global' | 'patient'
  patientHash    String?  @map("patient_hash")
  status         String   @default("open") // 'open' | 'closed'
  messageCount   Int      @default(0) @map("message_count")
  archived       Int      @default(0)
  createdAt      String   @map("created_at")
  lastMessageAt  String?  @map("last_message_at")
  closedAt       String?  @map("closed_at")
  compactedUptoIdx Int?   @map("compacted_upto_idx") // S2: compaction cursor (Session Memory)

  user User @relation(fields: [userId], references: [id])
  @@index([userId, scope, status, lastMessageAt(sort: Desc)])
  @@index([patientHash, status])
  @@map("nexus_sessions")
}

model UserSetting {
  userId    String @map("user_id")
  key       String
  value     String
  updatedAt Int    @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  @@id([userId, key])
  @@map("user_settings")
}

model UserSkillPref {
  userId     String @map("user_id")
  skillName  String @map("skill_name")
  enabled    Int    @default(1)
  autoApply  Int    @default(0) @map("auto_apply")
  source     String @default("")
  createdAt  String @map("created_at")

  user User @relation(fields: [userId], references: [id])
  @@id([userId, skillName])
  @@map("user_skill_prefs")
}

model Doc {
  id        String @id
  userId    String @map("user_id")
  title     String @default("")
  body      String @default("")
  // #773: deck 资产 — AI 编排产物（organize 导出）与 deck 视图编辑的
  // 独立数据源（presentationContentSchema JSON 字符串，可空）。
  // 与 body 分治：文档视图编辑 body，deck 视图编辑 deck，互不污染。
  deck      String? @map("deck")
  // #989 Phase 1: 块级结构投影 — 真相源 body 的派生投影（blockProjectionSchema
  // JSON 字符串，可空）。写回单点（writeDocVersion）同帧维护：body 变则投影
  // 同帧重算，强一致；存量文档首次写回时自动建投影。读侧发现 bodyHash 与
  // body 不符（投影过期）按无投影处理，绝不信任过期投影。
  blockProjection String? @map("block_projection")
  // #1101（pptx 字节单一标准）— deck 工件指针：真实 pptx 字节落在 FileIndex
  // 工件（uploads 目录 + file_index 行），此处松散引用其 id（刻意不建 relation：
  // 工件生命周期独立于 Doc，按存储级指针语义管理）。Doc.deck 降级为 DeckWire
  // 投影缓存（pptx-extractor 按工件重建）。契约见
  // docs/design/DECK_PPTX_SINGLE_STANDARD.md §3。
  deckArtifactId String? @map("deck_artifact_id")
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")
  studyId   String? @map("study_id") // #383: linked research study

  user       User            @relation(fields: [userId], references: [id])
  study      ResearchStudy?  @relation(fields: [studyId], references: [id])
  snapshots  DocSnapshot[]
  references DocReference[]
  citations  DocCitation[]
  chatMsgs   DocChatMessage[]
  sectionMeta DocSectionMeta[]
  comments   DocComment[]
  @@index([userId, updatedAt(sort: Desc)])
  @@index([studyId])
  @@map("docs")
}

model DocSnapshot {
  id        Int    @id @default(autoincrement())
  docId     String @map("doc_id")
  userId    String @map("user_id")
  body      String
  // #773: 同帧快照 deck（方案 A）— 恢复历史版本时 body+deck 一致回滚。
  deck      String? @map("deck")
  label     String @default("")
  createdAt String @map("created_at")

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)
  @@index([userId, docId, id(sort: Desc)])
  @@map("doc_snapshots")
}

// #996/#999: 节级元数据旁路表 — 作者轴（AI 写的=ai / 你写的=human）与
// 可信度轴（pending=验证中 / verified=已验证 / failed=失败）的用户可见
// 信任信号。刻意不进 BlockProjectionNode：投影是 body 的确定性纯函数
// （loadProjection 依赖"重建必一致"不变量），可变元数据混入会破坏它。
// 键 = 块投影 section 稳定 ID（s_<sha1前12>，正文编辑不换 ID）。
// 写回单点（writeDocVersion）挂钩：diff 旧/新投影 section hash → 变更节
// upsert（最后编辑者语义）；section 失效（改标题/删节）时清理旧行。
model DocSectionMeta {
  id           String @id @default(cuid())
  docId        String @map("doc_id")
  userId       String @map("user_id")
  sectionId    String @map("section_id")
  // 最后编辑者 — 混合作者（AI 初稿+人工修改）按最后编辑覆盖为 human。
  author       String @default("human") // 'ai' | 'human'
  // pending 由写回单点置入（AI 路径）；终态化器（异步、非阻塞）校验
  // 投影一致性后翻 verified；failed = 一致性校验不通过。human 写入直接
  // verified（用户自己的输入无需系统验证）。
  verifyStatus String @default("pending") @map("verify_status") // 'pending' | 'verified' | 'failed'
  updatedAt    String @map("updated_at")

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)
  @@unique([docId, sectionId])
  @@index([userId, docId])
  @@map("doc_section_meta")
}

model DocReference {
  id           String @id
  docId        String @map("doc_id")
  userId       String @map("user_id")
  refType      String @map("ref_type")
  targetId     String @map("target_id")
  granularity  String @default("")
  snapshot     String @default("")
  sourceNodes  String @default("[]") @map("source_nodes")
  createdAt    String @map("created_at")

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)
  @@index([userId, docId, createdAt])
  @@map("doc_references")
}

/// #1008/#1009（SECOND_BRAIN）— 建议态引用：待用户确认的材料建议
/// （pending → accepted/dismissed；accepted 时才产生 SessionReference）。
model SuggestedReference {
  id          String  @id @default(cuid())
  sessionId   String  @map("session_id")
  userId      String  @map("user_id")
  referenceId String  @map("reference_id")
  reason      String  @default("")
  /// #1036: 结构化原因（i18n）— 前端按 code 本地化渲染；reason 保留原文兼容旧行。
  reasonCode  String? @map("reason_code")
  score       Int?
  suggestedAt String  @map("suggested_at")
  status      String  @default("pending")
  resolvedAt  String? @map("resolved_at")

  @@index([userId, sessionId, status])
  @@index([userId, referenceId, status])
  @@map("suggested_references")
}

/// #1015（SECOND_BRAIN Phase C）— 记忆层级升降级留痕（可见可回滚，原则 4）：
/// 每次 promote/demote 一条；/api/v1/memory/health 回溯。
model MemoryTierEvent {
  id       String @id @default(cuid())
  userId   String @map("user_id")
  unitId   String @map("unit_id")
  fromTier String @map("from_tier")
  toTier   String @map("to_tier")
  action   String
  reason   String @default("")
  at       String

  @@index([userId, at])
  @@index([userId, unitId, at])
  @@map("memory_tier_events")
}

/// #1014（SECOND_BRAIN Phase B）— 记忆使用反馈总线（append-only）：
/// 谁用了哪条记忆（fact/summary/reference/skill）— MemoryGranularityController
/// (#1013) 的输入源；写入 fire-and-forget，不阻塞调用方响应。
model MemoryUsageEvent {
  id        String  @id @default(cuid())
  userId    String  @map("user_id")
  unitType  String  @map("unit_type")
  unitId    String  @map("unit_id")
  action    String
  sessionId String? @map("session_id")
  at        String

  @@index([userId, unitId, at])
  @@index([userId, at])
  @@map("memory_usage_events")
}

/// #1083/#1084（epic）— 正式参考文献（结构化引用对象）：
/// 与「参考材料池」（DocReference/ReferenceItem — 上传 PDF/URL/粘贴文本的
/// 写作背景素材）架构隔离。正式引用必须来自文献检索（PubMed/Crossref）
/// 且强制携带 DOI（格式校验在 contracts docCitationSchema + 写入路径双锁）。
/// 序号不落库 — 渲染/导出时按正文中 [cite:id] 首次出现顺序动态计算
/// （contracts assignCitationNumbers，#1077/#1079/#1099 共用）。
model DocCitation {
  id      String @id
  docId   String @map("doc_id")
  doi     String
  pmid    String?
  title   String
  /// JSON 序列化的作者数组（["Zhang S","Li Q"]）
  authors String
  journal String?
  year    Int?
  url     String?
  /// 'pubmed' | 'crossref'（检索来源 — 上传素材永远进不了本表）
  source  String
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)
  @@unique([docId, doi])
  @@index([docId])
  @@map("doc_citations")
}

/// #1005（SECOND_BRAIN Phase 0）— 用户级引用内容池：一份内容只存一次，
/// 跨写作/主 chat 会话复用（区别于 DocReference 绑 docId 的旧模型）。
/// kind: 'file' | 'kb_summary' | 'pasted_text'。
/// 本表与 DocReference 并行（additive + 写路径双写过渡），读路径在 #1006
/// 统一切换；回填迁移见 common/reference-migration.ts。
model ReferenceItem {
  id        String  @id
  userId    String  @map("user_id")
  kind      String
  /// file → FileIndex.id；kb_summary → Summary stableId；pasted_text → null。
  sourceRef String? @map("source_ref")
  label     String  @default("")
  /// kb_summary/pasted_text 直接是正文；file 类为文件名（注入时懒解析）。
  snapshot  String  @default("")
  createdAt String  @map("created_at")
  updatedAt String  @map("updated_at")

  sessionRefs SessionReference[]

  @@index([userId, updatedAt])
  @@index([userId, kind])
  @@map("reference_items")
}

/// #1005（SECOND_BRAIN Phase 0）— 会话级引用挂载（正式生效）。
/// sessionId 复用项目既有约定：写作 'doc-<docId>'，主 chat 普通 sessionId。
/// 取消引用只删本表（不影响 ReferenceItem 本体与其他会话）。
model SessionReference {
  id          String @id
  sessionId   String @map("session_id")
  userId      String @map("user_id")
  referenceId String @map("reference_id")
  addedAt     String @map("added_at")
  /// 'manual' | 'suggestion_accepted'（#1008 起写入建议采纳来源）。
  source      String @default("manual")

  reference ReferenceItem @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  @@unique([sessionId, referenceId])
  @@index([userId, sessionId, addedAt])
  @@map("session_references")
}

model DocChatMessage {
  id         String @id
  docId      String @map("doc_id")
  userId     String @map("user_id")
  role       String
  text       String @default("")
  docApplied Int    @default(0) @map("doc_applied")
  createdAt  String @map("created_at")

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)
  @@index([userId, docId, createdAt])
  @@map("doc_chat_messages")
}

// #1039: 评论线程旁路表 — 评论锚点不能塞进正文（正文每次加载/写回都做
// markdown↔html 转换，任何自定义 mark 会被 round-trip 吃掉），做成 sidecar
// 数据，参照 DocSectionMeta / DocSnapshot 的旁路先例。anchorText 存被评论的
// 原文片段，正文漂移时由列表接口跑 anchor-diagnostics 模糊重定位（与
// edit_document 同一套容错，不重复造轮子）。
model DocComment {
  id        String  @id @default(cuid())
  docId     String  @map("doc_id")
  sectionId String  @map("section_id")
  // #1051: 锚点目标判别 — 'section'（正文节，默认，存量数据兼容）|
  // 'deck_slide'（deck 幻灯片页，section_id 为空串，slideIndex 必填）
  // #1090-6: 枚举约束说明 — Prisma 5.22 不支持 SQLite enum（prisma validate
  // 报 P1012 "the current connector does not support enums"，已实测），SQLite
  // 路径不存在「enum 即 TEXT CHECK」的自动处理；db push 也无迁移基建可挂
  // CHECK 约束。故枚举合法性由写入路径边界强制：HTTP 层 zod（comments.router
  // createCommentSchema 的 target 枚举 / patchCommentSchema 与 listQuerySchema
  // 的 status 枚举）+ 内部写路径的类型收口（appendCommentReplyInternal 契约
  // 类型化 #1090-5）。DB 层只能保证 TEXT — 非法值由 API 400 拒绝，不落库。
  target    String  @default("section")
  // #1051: deck_slide 锚点 — slideIndex 1-based（与 edit_deck 的 slide_index
  // 同口径）；blockIndex 可空（0-based 内容块序，整页评论为 null）
  slideIndex Int?   @map("slide_index")
  blockIndex Int?   @map("block_index")
  // 被评论的原文片段（模糊重定位锚点 — 正文编辑后允许漂移）
  anchorText String @map("anchor_text")
  // #1090-6: status 枚举（'open'|'resolved'）— Prisma 5.22 + SQLite 无 enum
  // 能力（P1012，见上方 target 注释），DB 层仅 TEXT；合法性由 zod 边界强制。
  status    String  @default("open") // 'open' | 'resolved'
  // 创建者 userId（归属校验以 Doc.userId 为准 — 跟随现有 doc 路由口径）
  createdBy String  @map("created_by")
  createdAt String  @map("created_at")
  // status=open 为 null；resolved 写入切换时刻，reopen 置回 null
  resolvedAt String? @map("resolved_at")
  // #1091: deck 评论 pending-confirm 态持久化 — 写回前画布 deck JSON 快照
  // （仅 target='deck_slide' 语义使用）。AI 写回落地时上报落库，刷新后据此
  // 恢复「确认修改/撤销修改」按钮态，撤销以服务端快照为准；确认/撤销成功
  // 后清除（null）。TEXT 旁路同 deck 大字段先例，SQLite 无枚举/回填风险。
  deckSnapshot String? @map("deck_snapshot")

  doc     Doc               @relation(fields: [docId], references: [id], onDelete: Cascade)
  replies DocCommentReply[]

  @@index([docId, status])
  @@index([docId, sectionId])
  @@map("doc_comments")
}

// #1039: 评论回复 — 结构比照 DocChatMessage，但挂在 comment 而不是 doc 上；
// role 区分 user/ai，按 createdAt 时间序追加成线程。
// #1090-6: role 枚举（'user'|'ai'）— 同 DocComment：Prisma 5.22 + SQLite 无
// enum/CHECK 能力（P1012），DB 层仅 TEXT。合法性由边界强制：HTTP 层 zod
// （通用回复端点仅接受 role:'user'，自封 'ai' → 400；ai-replies 端点服务端
// 固定 'ai'）+ 内部写路径类型收口（appendCommentReplyInternal 的
// InternalCaller 契约，#1090-5）。
model DocCommentReply {
  id        String @id @default(cuid())
  commentId String @map("comment_id")
  role      String // 'user' | 'ai'
  text      String
  createdAt String @map("created_at")

  comment DocComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  @@index([commentId, createdAt])
  @@map("doc_comment_replies")
}

model ChatTakeaway {
  id              Int     @id @default(autoincrement())
  userId          String  @map("user_id")
  scopeKind       String  @map("scope_kind")
  scopeRef        String  @map("scope_ref")
  sessionId       String  @map("session_id")
  text            String
  tag             String?
  confidence      Float   @default(0.7)
  distilledAt     Int     @map("distilled_at")
  sourceEventIdx  Int?    @map("source_event_idx")
  medicAckedAt    Int?    @map("medic_acked_at")
  medicRejectedAt Int?    @map("medic_rejected_at")

  user User @relation(fields: [userId], references: [id])
  @@index([userId, distilledAt(sort: Desc)])
  @@index([userId, scopeKind, scopeRef, distilledAt(sort: Desc)])
  @@map("chat_takeaways")
}

model ResearchStudy {
  id        String @id
  userId    String @map("user_id")
  name      String
  shortCode String @map("short_code")
  protocol  String @default("{}")
  // #409: study type — clinical (trials/cohort) vs basic (wet lab).
  studyType String @default("clinical") @map("study_type")
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")

  user        User @relation(fields: [userId], references: [id])
  enrollments ResearchEnrollment[]
  screenings  ResearchScreening[]
  observations ResearchObservation[]
  assessments ResearchAssessment[]
  protocolRules StudyProtocolRule[]
  events      StudyEvent[]
  papers      Doc[]
  @@index([userId, updatedAt(sort: Desc)])
  @@map("research_studies")
}

model ResearchEnrollment {
  studyId      String  @map("study_id")
  patientHash  String  @map("patient_hash")
  arm          String  @default("default")
  enrolledAt   String  @map("enrolled_at")
  unenrolledAt String? @map("unenrolled_at")

  study ResearchStudy @relation(fields: [studyId], references: [id])
  @@id([studyId, patientHash])
  @@map("research_enrollments")
}

model ResearchScreening {
  id               String @id
  studyId          String @map("study_id")
  patientHash      String @map("patient_hash")
  initials         String @default("")
  verdict          String @default("pending")
  reason           String @default("")
  // #10: per-rule screening results as JSON array
  // [{"ruleId","rule","category","passed","detail"}]
  criteriaResults  String @default("[]") @map("criteria_results")
  scannedAt        String @map("scanned_at")

  study ResearchStudy @relation(fields: [studyId], references: [id])
  @@index([studyId, patientHash])
  @@map("research_screenings")
}

model ResearchObservation {
  id          String @id
  studyId     String @map("study_id")
  patientHash String @map("patient_hash")
  kind        String
  grade       Int    @default(0)
  dlt         Int    @default(0)
  confirmed   Int    @default(0)
  note        String @default("")
  createdAt   String @map("created_at")

  study ResearchStudy @relation(fields: [studyId], references: [id])
  @@index([studyId, patientHash])
  @@map("research_observations")
}

model ResearchAssessment {
  id          String @id
  studyId     String @map("study_id")
  patientHash String @map("patient_hash")
  visit       String
  title       String
  dueAt       String @map("due_at")
  completedAt String? @map("completed_at")
  note        String @default("")

  study ResearchStudy @relation(fields: [studyId], references: [id])
  @@index([studyId, patientHash])
  @@map("research_assessments")
}

model StudyProtocolRule {
  id            String @id
  studyId       String @map("study_id")
  category      String
  rule          String
  detail        String @default("")
  status        String @default("pending")
  version       Int    @default(1)
  sourceJobId   String? @map("source_job_id")
  extractedFrom String? @map("extracted_from")
  createdAt     String @map("created_at")
  updatedAt     String @map("updated_at")

  study ResearchStudy @relation(fields: [studyId], references: [id])
  @@index([studyId, category, status])
  @@index([studyId, status])
  @@map("study_protocol_rules")
}

model StudyEvent {
  id           String @id
  studyId      String @map("study_id")
  visit        String
  timing       String
  assessments  String @default("[]")
  status       String @default("pending")
  sourceRuleId String? @map("source_rule_id")
  createdAt    String @map("created_at")
  updatedAt    String @map("updated_at")

  study ResearchStudy @relation(fields: [studyId], references: [id])
  @@index([studyId, visit])
  @@map("study_events")
}

model PatientRecord {
  hash          String  @id
  userId        String  @map("user_id")
  name          String  @default("")
  initials      String  @default("")
  age           Int     @default(0)
