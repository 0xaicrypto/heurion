// #825: 学术渲染产物溯源 — 渲染源码留存在库,支撑图库"查看源码/重渲染"
// 与 sha256 渲染缓存(同源码二次请求不重复 enqueue)。缓存三级:
// FigureRender 表(DB) → FileIndex(盘) → 前端客户端渲染。
model FigureRender {
  id         String  @id @default(cuid())
  userId     String  @map("user_id")
  kind       String // 'mermaid' | 'latex_math'
  source     String // 渲染源码(≤32KB, contracts figurePayloadSchema)
  optionsJson String @map("options_json") // {display?, theme?, scale?} — 影响 sha256
  sha256     String
  svgFileId  String  @map("svg_file_id")
  width      Int?
  height     Int?
  renderedMs Int?    @map("rendered_ms")
  createdAt  String  @map("created_at")
  updatedAt  String  @map("updated_at")
  user       User    @relation(fields: [userId], references: [id])
  @@unique([userId, sha256])
  @@index([userId, createdAt(sort: Desc)])
  @@map("figure_renders")
}

// #976: 会话级任务清单 — 复杂任务的步骤账本（set_task_plan 工具 +
// context 注入 + 写回对账）。steps 存 JSON（contracts taskPlanSchema）。
// sessionId 维度一活跃清单：同会话新 create 语义上取代旧清单（旧置 cancelled）。
model TaskPlan {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  sessionId String @map("session_id")
  title     String
  stepsJson String @map("steps_json")
  status    String @default("active") // 'active' | 'completed' | 'cancelled'
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  @@index([userId, sessionId, status])
  @@map("task_plans")
}
