  status    String @default("draft") // 'draft' | 'confirmed' | 'promoted' (#842: promoted = 已迁 graph SkillNode,纯归档零逻辑参与)
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")
  @@index([userId, status])
  @@map("captured_skills")
}

// #284: email verification codes (register/bind/reset-password).
model VerificationCode {
