generator client {
  provider = "prisma-client-js"
  // Ship both engine binaries — the Docker runtime openssl flavor can vary
  // across base images (observed: generated for 1.1.x, runtime required
  // 3.0.x). "native" covers local dev.
  binaryTargets = ["native", "debian-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id
  displayName     String    @unique @map("display_name")
  passwordHash    String?   @map("password_hash")
  role            String    @default("user")
  status          String    @default("approved")
  // #284: unique identity fields — email is verified, phone is storage-only.
  email           String?   @unique
  emailVerified   Int       @default(0) @map("email_verified")
  phone           String?   @unique
  organization    String?
  intendedUse     String?   @map("intended_use")
  isAdmin         Int       @default(0) @map("is_admin")
  tier            String    @default("beta")
  stripeCustomerId String?  @map("stripe_customer_id")
  stripeSubscriptionId String? @map("stripe_subscription_id")
  subscriptionState String? @map("subscription_state")
  trialEndsAt      String?  @map("trial_ends_at")
  disabledAt       String?  @map("disabled_at")
  lastLoginAt      String?  @map("last_login_at")
  avatarEmoji      String?  @default("🩺") @map("avatar_emoji")
  deletedAt        String?  @map("deleted_at")
  createdAt        String   @map("created_at")
  updatedAt        String   @map("updated_at")

  sessions      Session[]
  docs          Doc[]
  skillPrefs    UserSkillPref[]
  settings      UserSetting[]
  chatTakeaways ChatTakeaway[]
  studies       ResearchStudy[]
  patients      PatientRecord[]
   knowledgeGaps KnowledgeGap[]
   telemetryEvents TelemetryEvent[]
   pluginInstallations PluginInstallation[]
   externalUserMappings ExternalUserMapping[]
   medicalRecordEntries MedicalRecordEntry[]
   approvalRequests ApprovalRequest[]
   @@map("users")
}

model Session {
  id             String   @id
  userId         String   @map("user_id")
  title          String
  scope          String   @default("global") // 'global' | 'patient'
  patientHash    String?  @map("patient_hash")
  status         String   @default("open") // 'open' | 'closed'
  messageCount   Int      @default(0) @map("message_count")
  archived       Int      @default(0)
  createdAt      String   @map("created_at")
  lastMessageAt  String?  @map("last_message_at")
  closedAt       String?  @map("closed_at")
  compactedUptoIdx Int?   @map("compacted_upto_idx") // S2: compaction cursor (Session Memory)

  user User @relation(fields: [userId], references: [id])
  @@index([userId, scope, status, lastMessageAt(sort: Desc)])
  @@index([patientHash, status])
  @@map("nexus_sessions")
}

model UserSetting {
  userId    String @map("user_id")
  key       String
  value     String
  updatedAt Int    @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  @@id([userId, key])
  @@map("user_settings")
}

model UserSkillPref {
  userId     String @map("user_id")
  skillName  String @map("skill_name")
  enabled    Int    @default(1)
  autoApply  Int    @default(0) @map("auto_apply")
  source     String @default("")
  createdAt  String @map("created_at")

  user User @relation(fields: [userId], references: [id])
  @@id([userId, skillName])
  @@map("user_skill_prefs")
}

model Doc {
  id        String @id
  userId    String @map("user_id")
  title     String @default("")
  body      String @default("")
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")
  studyId   String? @map("study_id") // #383: linked research study

  user       User            @relation(fields: [userId], references: [id])
  study      ResearchStudy?  @relation(fields: [studyId], references: [id])
  snapshots  DocSnapshot[]
  references DocReference[]
  chatMsgs   DocChatMessage[]
  @@index([userId, updatedAt(sort: Desc)])
  @@index([studyId])
  @@map("docs")
}

model DocSnapshot {
  id        Int    @id @default(autoincrement())
  docId     String @map("doc_id")
  userId    String @map("user_id")
  body      String
  label     String @default("")
  createdAt String @map("created_at")

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)
  @@index([userId, docId, id(sort: Desc)])
  @@map("doc_snapshots")
}

model DocReference {
  id           String @id
  docId        String @map("doc_id")
  userId       String @map("user_id")
  refType      String @map("ref_type")
  targetId     String @map("target_id")
  granularity  String @default("")
  snapshot     String @default("")
  sourceNodes  String @default("[]") @map("source_nodes")
  createdAt    String @map("created_at")

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)
  @@index([userId, docId, createdAt])
  @@map("doc_references")
}

model DocChatMessage {
  id         String @id
  docId      String @map("doc_id")
  userId     String @map("user_id")
  role       String
  text       String @default("")
  docApplied Int    @default(0) @map("doc_applied")
  createdAt  String @map("created_at")

  doc Doc @relation(fields: [docId], references: [id], onDelete: Cascade)
  @@index([userId, docId, createdAt])
  @@map("doc_chat_messages")
}

model ChatTakeaway {
  id              Int     @id @default(autoincrement())
  userId          String  @map("user_id")
  scopeKind       String  @map("scope_kind")
  scopeRef        String  @map("scope_ref")
  sessionId       String  @map("session_id")
  text            String
  tag             String?
  confidence      Float   @default(0.7)
  distilledAt     Int     @map("distilled_at")
  sourceEventIdx  Int?    @map("source_event_idx")
  medicAckedAt    Int?    @map("medic_acked_at")
  medicRejectedAt Int?    @map("medic_rejected_at")

  user User @relation(fields: [userId], references: [id])
  @@index([userId, distilledAt(sort: Desc)])
  @@index([userId, scopeKind, scopeRef, distilledAt(sort: Desc)])
  @@map("chat_takeaways")
}

model ResearchStudy {
  id        String @id
  userId    String @map("user_id")
  name      String
  shortCode String @map("short_code")
  protocol  String @default("{}")
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")

  user        User @relation(fields: [userId], references: [id])
  enrollments ResearchEnrollment[]
  screenings  ResearchScreening[]
  observations ResearchObservation[]
  assessments ResearchAssessment[]
  protocolRules StudyProtocolRule[]
  events      StudyEvent[]
  papers      Doc[]
  @@index([userId, updatedAt(sort: Desc)])
  @@map("research_studies")
}

model ResearchEnrollment {
  studyId      String  @map("study_id")
  patientHash  String  @map("patient_hash")
  arm          String  @default("default")
  enrolledAt   String  @map("enrolled_at")
  unenrolledAt String? @map("unenrolled_at")

  study ResearchStudy @relation(fields: [studyId], references: [id])
  @@id([studyId, patientHash])
  @@map("research_enrollments")
}

model ResearchScreening {
  id          String @id
  studyId     String @map("study_id")
  patientHash String @map("patient_hash")
  initials    String @default("")
  verdict     String @default("pending")
  reason      String @default("")
  scannedAt   String @map("scanned_at")

  study ResearchStudy @relation(fields: [studyId], references: [id])
  @@index([studyId, patientHash])
  @@map("research_screenings")
}

model ResearchObservation {
  id          String @id
  studyId     String @map("study_id")
  patientHash String @map("patient_hash")
  kind        String
  grade       Int    @default(0)
  dlt         Int    @default(0)
  confirmed   Int    @default(0)
  note        String @default("")
  createdAt   String @map("created_at")

  study ResearchStudy @relation(fields: [studyId], references: [id])
  @@index([studyId, patientHash])
  @@map("research_observations")
}

model ResearchAssessment {
  id          String @id
  studyId     String @map("study_id")
  patientHash String @map("patient_hash")
  visit       String
  title       String
  dueAt       String @map("due_at")
  completedAt String? @map("completed_at")
  note        String @default("")

  study ResearchStudy @relation(fields: [studyId], references: [id])
  @@index([studyId, patientHash])
  @@map("research_assessments")
}

model StudyProtocolRule {
  id            String @id
  studyId       String @map("study_id")
  category      String
  rule          String
  detail        String @default("")
  status        String @default("pending")
  version       Int    @default(1)
  sourceJobId   String? @map("source_job_id")
  extractedFrom String? @map("extracted_from")
  createdAt     String @map("created_at")
  updatedAt     String @map("updated_at")

  study ResearchStudy @relation(fields: [studyId], references: [id])
  @@index([studyId, category, status])
  @@index([studyId, status])
  @@map("study_protocol_rules")
}

model StudyEvent {
  id           String @id
  studyId      String @map("study_id")
  visit        String
  timing       String
  assessments  String @default("[]")
  status       String @default("pending")
  sourceRuleId String? @map("source_rule_id")
  createdAt    String @map("created_at")
  updatedAt    String @map("updated_at")

  study ResearchStudy @relation(fields: [studyId], references: [id])
  @@index([studyId, visit])
  @@map("study_events")
}

model PatientRecord {
  hash          String  @id
  userId        String  @map("user_id")
  name          String  @default("")
  initials      String  @default("")
  age           Int     @default(0)
  sex           String  @default("")
  chiefComplaint String @default("") @map("chief_complaint")
  source        String  @default("manual")
  createdAt     String  @map("created_at")
  updatedAt     String  @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  @@index([userId, createdAt(sort: Desc)])
  @@map("patient_records")
}

model MedicalRecord {
  id          String @id
  patientHash String @map("patient_hash")
  userId      String @map("user_id")
  title       String @default("")
  sections    String @default("{}")
  createdAt   String @map("created_at")
  updatedAt   String @map("updated_at")

  @@index([patientHash, createdAt(sort: Desc)])
  @@index([userId, patientHash])
  @@map("medical_records")
}

model MedicalRecordEntry {
  id                String  @id @default(cuid())
  patientHash       String  @map("patient_hash")
  userId            String  @map("user_id")
  type              String
  title             String
  date              String
  content           String
  aiSummary         String? @map("ai_summary")
  sourceFileId      String? @map("source_file_id")
  sourceStudyId     String? @map("source_study_id")
  sourceJobId       String? @map("source_job_id")
  extractedText     String? @map("extracted_text")
  rawJson           String? @map("raw_json")
  status            String  @default("pending_review")
  createdBy         String  @map("created_by")
  confirmedAt       String? @map("confirmed_at")
  confirmedBy       String? @map("confirmed_by")
  rejectedReason    String? @map("rejected_reason")
  version           Int     @default(1)
  previousVersionId String? @map("previous_version_id")
  linkedRecordIds   String  @default("[]") @map("linked_record_ids")
  createdAt         String  @map("created_at")
  updatedAt         String  @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  @@index([patientHash, date(sort: Desc)])
  @@index([status])
  @@index([type])
  @@index([sourceFileId])
  @@index([sourceJobId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("medical_record_entries")
}

model ApprovalRequest {
  id         String  @id @default(cuid())
  userId     String  @map("user_id")
  targetType String  @map("target_type")
  targetId   String  @map("target_id")
  status     String  @default("pending")
  payload    String
  diff       String?
  reason     String?
  actorId    String? @map("actor_id")
  createdAt  String  @map("created_at")
  resolvedAt String? @map("resolved_at")

  user User @relation(fields: [userId], references: [id])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("approval_requests")
}

model AuditLog {
  id         String  @id @default(cuid())
  actor      String
  action     String
  targetType String  @map("target_type")
  targetId   String  @map("target_id")
  before     String?
  after      String?
  reason     String?
  createdAt  String  @map("created_at")

  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([actor, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model KbExtractCursor {
  id               String @id @default(cuid())
  userId           String @map("user_id")
  scopeType        String @map("scope_type") // 'patient' | 'global' | 'study'
  patientHash      String @default("") @map("patient_hash") // '' = scope-level
  sessionId        String @default("") @map("session_id") // '' = scope-level; else per-session (#181)
  extractedUptoIdx Int    @map("extracted_upto_idx")
  updatedAt        String @map("updated_at")

  @@unique([userId, scopeType, patientHash, sessionId])
  @@map("kb_extract_cursors")
}

model MemoryProposal {
  id             String  @id @default(cuid())
  userId         String  @map("user_id")
  scopeType      String  @map("scope_type") // 'patient' | 'global' | 'study'
  patientHash    String? @map("patient_hash")
  studyId        String? @map("study_id")
  kind           String  // fact | article | episode_summary | compaction_summary
  content        String
  importance     Int     @default(3)
  confidence     String  @default("medium") // high | medium | low
  reason         String?
  sourceRange    String? @map("source_range")
  conflictsWith  String? @map("conflicts_with") // JSON: [{"stableId","content"}] — same-scope confirmed facts this proposal contradicts
  status         String  @default("pending") // pending | approved | rejected
  rejectedReason String? @map("rejected_reason")
  createdAt      String  @map("created_at")
  resolvedAt     String? @map("resolved_at")
  resolvedBy     String? @map("resolved_by")
  archivedAt     String? @map("archived_at") // 13.4D: auto-archived after 7 days (low importance / summaries)
  category       String? // 13.4F: extraction category for quality feedback stats

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([scopeType, patientHash, status])
  @@map("memory_proposals")
}

model KbCompaction {
  id             String @id @default(cuid())
  userId         String @map("user_id")
  sessionId      String @map("session_id")
  summary        String
  coveredUptoIdx Int    @map("covered_upto_idx") // last event idx covered by this compaction
  tokenSavings   Int?   @map("token_savings")
  createdAt      String @map("created_at")

  @@unique([sessionId, coveredUptoIdx])
  @@index([userId, sessionId, coveredUptoIdx(sort: Desc)])
  @@map("kb_compactions")
}

model IngestionJob {
  id            String  @id @default(cuid())
  userId        String  @map("user_id")
  fileId        String  @map("file_id")
  fileName      String  @map("file_name")
  mimeType      String  @map("mime_type")
  patientHash   String? @map("patient_hash")
  studyId       String? @map("study_id")
  uploadedBy    String  @map("uploaded_by")
  extractedText String? @map("extracted_text")
  extractedJson String? @map("extracted_json")
  status        String  @default("pending")
  confidence    String?
  reasoning     String?
  resultPayload String? @map("result_payload")
  retryCount    Int     @default(0) @map("retry_count")
  failedReason  String? @map("failed_reason")
  createdAt     String  @map("created_at")
  updatedAt     String  @map("updated_at")

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([patientHash, status])
  @@index([studyId, status])
  @@map("ingestion_jobs")
}

model KnowledgeGap {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  workspaceId String  @map("workspace_id")
  content     String
  source      String
  sourceId    String? @map("source_id")
  status      String  @default("open")
  answerId    String? @map("answer_id")
  answerText  String? @map("answer_text")
  createdAt   String  @map("created_at")
  updatedAt   String  @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  @@index([userId, status, createdAt(sort: Desc)])
  @@index([workspaceId, status])
  @@index([workspaceId, source])
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("knowledge_gaps")
}

model TelemetryEvent {
  id          String  @id @default(cuid())
  userId      String  @map("user_id")
  workspaceId String  @map("workspace_id")
  category    String
  action      String
  metadata    String?
  createdAt   String  @map("created_at")

  user User @relation(fields: [userId], references: [id])
  @@index([userId, category, createdAt(sort: Desc)])
  @@index([workspaceId, category, createdAt(sort: Desc)])
  @@index([category, createdAt(sort: Desc)])
  @@map("telemetry_events")
}

model PluginCatalog {
  id          String  @id
  source      String  @default("official")
  sourceUrl   String? @map("source_url")
  manifest    String
  createdAt   String  @map("created_at")
  updatedAt   String  @map("updated_at")

  installations PluginInstallation[]
  externalInstallations ExternalPluginInstallation[]
  @@index([source])
  @@map("plugin_catalog")
}

model PluginInstallation {
  id           String  @id @default(cuid())
  userId       String  @map("user_id")
  pluginId     String  @map("plugin_id")
  version      String
  enabled      Int     @default(1)
  config       String  @default("{}")
  installedAt  String  @map("installed_at")
  updatedAt    String  @map("updated_at")

  user   User          @relation(fields: [userId], references: [id])
  plugin PluginCatalog @relation(fields: [pluginId], references: [id])

  @@unique([userId, pluginId])
  @@index([userId, enabled])
  @@map("plugin_installations")
}

model PluginAuditLog {
  id            String  @id @default(cuid())
  userId        String  @map("user_id")
  pluginId      String  @map("plugin_id")
  toolName      String  @map("tool_name")
  jobId         String  @map("job_id")
  status        String
  durationMs    Int     @map("duration_ms")
  inputSummary  String? @map("input_summary")
  errorMessage  String? @map("error_message")
  createdAt     String  @map("created_at")

  @@index([userId, pluginId, createdAt(sort: Desc)])
  @@index([jobId])
  @@map("plugin_audit_logs")
}

model ExternalApplication {
  id           String  @id @default(cuid())
  clientId     String  @unique @map("client_id")
  clientSecret String  @map("client_secret")
  name         String
  scopes       String  @default("[]")
  quotas       String  @default("{}")
  createdAt    String  @map("created_at")
  updatedAt    String  @map("updated_at")

  @@map("external_applications")
}

model ExternalUserMapping {
  id             String @id @default(cuid())
  externalAppId  String @map("external_app_id")
  externalUserId String @map("external_user_id")
  heurionUserId  String @map("heurion_user_id")
  createdAt      String @map("created_at")

  user User @relation(fields: [heurionUserId], references: [id])

  @@unique([externalAppId, externalUserId])
  @@index([heurionUserId])
  @@map("external_user_mappings")
}

model ExternalPluginInstallation {
  id             String @id @default(cuid())
  externalAppId  String @map("external_app_id")
  externalUserId String @map("external_user_id")
  pluginId       String @map("plugin_id")
  version        String
  enabled        Int    @default(1)
  config         String  @default("{}")
  createdAt      String @map("created_at")
  updatedAt      String @map("updated_at")

  plugin PluginCatalog @relation(fields: [pluginId], references: [id])

  @@unique([externalAppId, externalUserId, pluginId])
  @@index([externalAppId, externalUserId, enabled])
  @@map("external_plugin_installations")
}

model ExternalJobMapping {
  id             String @id @default(cuid())
  externalAppId  String @map("external_app_id")
  externalUserId String @map("external_user_id")
  pluginId       String @map("plugin_id")
  jobId          String @map("job_id")
  toolName       String @map("tool_name")
  createdAt      String @map("created_at")

  @@unique([externalAppId, jobId])
  @@index([externalUserId])
  @@map("external_job_mappings")
}

// #105: configurable permission rules — allow/deny/ask per action/resource/role.
model ApprovalRule {
  id        String @id @default(cuid())
  action    String @map("action") // 'approve' | 'reject' | 'view'
  resource  String @map("resource") // 'MedicalRecordEntry' | 'Skill' | 'MemoryProposal' | '*'
  effect    String @map("effect") // 'allow' | 'deny' | 'ask'
  role      String @default("*") @map("role") // 'admin' | 'doctor' | 'pi' | '*'
  priority  Int    @default(0) @map("priority")
  enabled   Int    @default(1) @map("enabled")
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")
  @@index([action, resource, role])
  @@map("approval_rules")
}

// #298: skills captured from real conversations — structured, reusable.
model CapturedSkill {
  id        String @id @default(cuid())
  userId    String @map("user_id")
  name      String
  description String @default("")
  steps     String @default("") // JSON array of step descriptions
  prompt    String @default("") // full reusable prompt/template
  sourceSession String? @map("source_session") // session the skill came from
  status    String @default("draft") // 'draft' | 'confirmed'
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")
  @@index([userId, status])
  @@map("captured_skills")
}

// #284: email verification codes (register/bind/reset-password).
model VerificationCode {
  id        String @id @default(cuid())
  target    String @map("target") // email address
  code      String @map("code")
  purpose   String @map("purpose") // 'register' | 'bind' | 'reset'
  expiresAt String @map("expires_at")
  usedAt    String? @map("used_at")
  attempts  Int    @default(0) @map("attempts")
  ip        String? @map("ip") // #344: sender IP for per-IP rate limiting
  createdAt String @map("created_at")
  @@index([target, purpose, usedAt])
  @@index([ip, createdAt])
  @@map("verification_codes")
}

// #362: submission workflow — journal recommendations, cover letter, drafts.
model SubmissionDraft {
  id            String  @id @default(cuid())
  userId        String  @map("user_id")
  articleTitle  String  @map("article_title")
  abstract      String? @map("abstract")
  keywords      String? @map("keywords")
  authors       String? @map("authors") // JSON string array
  targetJournal String? @map("target_journal")
  coverLetter   String? @map("cover_letter")
  templateId    String? @map("template_id")
  status        String  @default("draft") @map("status")
  createdAt     String  @map("created_at")
  updatedAt     String  @map("updated_at")
  @@index([userId])
  @@map("submission_drafts")
}

// #420: sub-agent sessions — parallel deep-analysis task history.
model SubAgentSession {
  id         String  @id @default(cuid())
  userId     String  @map("user_id")
  task       String  @map("task")
  scope      String? @map("scope") // 'global' | 'patient:<hash>'
  topic      String? @map("topic") // literature | stats | clinical | ...
  summary    String? @map("summary")
  status     String  @default("done") @map("status") // running | done | failed
  turns      Int     @default(0) @map("turns")
  costTokens Int     @default(0) @map("cost_tokens")
  createdAt  String  @map("created_at")
  @@index([userId, createdAt])
  @@map("sub_agent_sessions")
}

// #417: MCP server connectors (frontend-managed, token encrypted).
model McpServer {
  id           String  @id @default(cuid())
  userId       String  @map("user_id")
  name         String  @map("name")
  url          String  @map("url")
  capabilities String  @map("capabilities") // JSON array: ["read","write"]
  tokenEnc     String? @map("token_enc") // encrypted bearer token
  enabled      Int     @default(1) @map("enabled")
  createdAt    String  @map("created_at")
  updatedAt    String  @map("updated_at")
  @@index([userId])
  @@map("mcp_servers")
}
