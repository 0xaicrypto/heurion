  ip        String? @map("ip") // #344: sender IP for per-IP rate limiting
  createdAt String @map("created_at")
  @@index([target, purpose, usedAt])
  @@index([ip, createdAt])
  @@map("verification_codes")
}

// #362: submission workflow — journal recommendations, cover letter, drafts.
