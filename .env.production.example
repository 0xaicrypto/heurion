# ══════════════════════════════════════════════════════════════════════
# Nexus server — PRODUCTION env config
# ══════════════════════════════════════════════════════════════════════
# Copy to .env.production and edit. NEVER commit the real file.
#
# Critical to-do checklist before first `docker compose up`:
#   [ ] Set HOSTNAME to <your-public-ip-with-dashes>.nip.io
#   [ ] Generate SERVER_SECRET — `openssl rand -hex 32`
#   [ ] Set GEMINI_API_KEY / DEEPSEEK_API_KEY (or your other LLM provider keys)
#   [ ] Set CORS_ALLOW_ORIGINS to your hostname (or "*" for permissive)

# ── Public-facing hostname (used by Caddy) ───────────────────────────
# Pattern: <ip-with-dashes>.nip.io  e.g. 1-2-3-4.nip.io  (free, no DNS
# config needed — nip.io resolves arbitrary "1-2-3-4" to 1.2.3.4).
HOSTNAME=1-2-3-4.nip.io

# ── Server ───────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
ENVIRONMENT=production
LOG_LEVEL=INFO

# REQUIRED — used to sign JWTs. If you change this all existing tokens
# become invalid (every user has to re-login). Generate with:
#   openssl rand -hex 32
SERVER_SECRET=CHANGE-ME-RUN-openssl-rand-hex-32

# ── Authentication (username + password, bcrypt) ─────────────────────
JWT_EXPIRATION_HOURS=24

# ── CORS ─────────────────────────────────────────────────────────────
# Add your deployment hostname; * allows any origin (dev only).
CORS_ALLOW_ORIGINS=https://1-2-3-4.nip.io

# ── API version gates ────────────────────────────────────────────────
# Increment when making breaking changes. Defaults to 1.
# API_VERSION=1

# ── LLM Gateway ─────────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# KIMI_API_KEY=   # Moonshot AI Kimi (DEFAULT_LLM_PROVIDER=kimi)
# DEEPSEEK_API_KEY=            # DEFAULT_LLM_PROVIDER=deepseek
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LLM_TIMEOUT_MS=180000        # LLM 请求超时(首字节),默认 300s;doc 会话长生成放宽到 600s(LLM_DOC_TIMEOUT_MS)
# ── 回合可靠性兜底 (#828/#829/#830) ───────────────────────────────
# TOOL_TIMEOUT_MS=120000        # 单工具挂死兜底(长工具按映射放宽:spawn_subagent 600s/delegate 360s 等)
# TURN_MAX_MS=900000            # 回合总时长 watchdog,默认 15min — 超时发可解释错误并中止
# LLM_BODY_IDLE_TIMEOUT_MS=120000 # LLM 响应头到达后 body/流的空闲超时(防中转站发完头后 stall 无限挂)
# SUBAGENT_CONCURRENCY=3        # spawn_subagent 批量扇出并发上限(1-6)
# ── PDF 公式视觉 OCR (#698 文档化) ─────────────────────────────────
# PDF 导入时把前 N 页渲染成图用视觉模型提取公式转 LaTeX;每页一次视觉调用。
# PDF_FORMULA_OCR=1            # '0' 关闭(省视觉调用成本,公式段为空)
# PDF_FORMULA_OCR_MAX_PAGES=10 # 只处理前 N 页
# PDF_FORMULA_OCR_CONCURRENCY=3 # 并行视觉调用数
# ── 意图语义路由 (#585) ─────────────────────────────────────────────
# off(默认): 纯 LLM 裁决;shadow: 语义层只探测并入库(分歧率 <5% + recall ≥90%
# + p50 <50ms 达标后切 on);on: 高置信 generate/veto 零 LLM 直通,uncertain 回落 LLM。
# 月报: tsx scripts/semantic-router-eval.ts --report
# INTENT_SEMANTIC_ROUTER=off

# ── Embedding ──────────────────────────────────────────────────────
# Uses Transformers.js (ONNX) via the `nexus-embedding-server` container.
# To use OpenAI embeddings instead, set EMBEDDING_PROVIDER=openai and
# provide OPENAI_API_KEY above.
EMBEDDING_PROVIDER=local
# #796: keep the model consistent with the rest of the deployment —
# switching models changes the vector dimension (bge-small 384 vs bge-m3
# 1024) and silently breaks semantic retrieval; a switch requires re-indexing.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_FALLBACK_PROVIDER=none          # openai or none
LOCAL_EMBEDDING_URL=http://localhost:8003/embed
# EMBEDDING_DEVICE=cpu                     # cpu | cuda | mps | wasm (embedding server)
# EMBEDDING_QUANTIZED=0                    # 1 to enable INT8 quantized weights (smaller, slightly lower quality)
# EMBEDDING_DTYPE=                         # fp32 | fp16 | int8; leave empty for model default
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Execution Plane / Sidecar worker ────────────────────────────────
# Optional: URL of the Heurion worker VPS and shared auth token.
# EXECUTION_PLANE_URL=https://worker.heurion.org
# WORKER_API_TOKEN=dev-worker-token

# ── Tool execution (server runs tools on the agent's behalf) ─────────
# Web search via Tavily. Without this, agent's web_search tool returns
# "no API key" and agent has to fall back to URL reading.
TAVILY_API_KEY=
# Higher-quality URL extraction (free tier works without key).
JINA_API_KEY=


# ── Persistence (don't usually need to touch in Docker) ──────────────
# Defaults set inside the Dockerfile point at /data on the volume:
#   NEXUS_TWIN_BASE_DIR=/data/twins
#   UPLOAD_DIR=/data/uploads
#   NEXUS_CACHE_DIR=/data/cache
#   DATABASE_URL=sqlite:////data/db/nexus_server.db

# ── Rate limiting ────────────────────────────────────────────────────
# Per-user, per-minute. Tune if you have heavy usage. The "other"
# bucket covers everything except /llm/chat.
RATE_LIMIT_LLM_REQUESTS_PER_MINUTE=60
RATE_LIMIT_OTHER_REQUESTS_PER_MINUTE=120

# ── S3 Backup (#290) ─────────────────────────────────────────────
# S3-compatible object storage for off-site backups (MinIO/Spaces/B2/AWS).
# Leave empty to skip backup setup entirely.
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=heurion-backups
# BACKUP_RETAIN_DAYS=30
# BACKUP_RETAIN_WEEKS=8

# ── #fix 2026-09: 纯文本模型注册表覆盖 ──
# 中转站实际路由的模型可能不支持视觉(注册表按模型名假设)。
# 逗号分隔;命中后附件图片注入侧降级为文字占位,网关另有 400 自愈重试兜底。
# LLM_TEXT_ONLY_MODELS=deepseek-v4-flash
