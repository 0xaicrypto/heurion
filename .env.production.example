# ══════════════════════════════════════════════════════════════════════
# Nexus server — PRODUCTION env config
# ══════════════════════════════════════════════════════════════════════
# Copy to .env.production and edit. NEVER commit the real file.
#
# Critical to-do checklist before first `docker compose up`:
#   [ ] Set HOSTNAME to <your-public-ip-with-dashes>.nip.io
#   [ ] Generate SERVER_SECRET — `openssl rand -hex 32`
#   [ ] Set GEMINI_API_KEY / DEEPSEEK_API_KEY (or your other LLM provider keys)
#   [ ] Set CORS_ALLOW_ORIGINS to your hostname (or "*" for permissive)

# ── Public-facing hostname (used by Caddy) ───────────────────────────
# Pattern: <ip-with-dashes>.nip.io  e.g. 1-2-3-4.nip.io  (free, no DNS
# config needed — nip.io resolves arbitrary "1-2-3-4" to 1.2.3.4).
HOSTNAME=1-2-3-4.nip.io

# ── Server ───────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8001
ENVIRONMENT=production
LOG_LEVEL=INFO

# REQUIRED — used to sign JWTs. If you change this all existing tokens
# become invalid (every user has to re-login). Generate with:
#   openssl rand -hex 32
SERVER_SECRET=CHANGE-ME-RUN-openssl-rand-hex-32

# ── Security keys (#925: 显式密钥，勿依赖兜底) ──────────────────────────
# 图表/文件直链 token 的 HMAC 签名密钥。不设则回落 SERVER_SECRET；
# 两者都缺时代码兜底 'dev-secret-key' —— 属已知风险（#925 后续 hardening）。
# 与 SERVER_SECRET 解耦的好处：轮换 SERVER_SECRET 不会使已发出的图表直链失效。
# REQUIRED — CHART_TOKEN_SECRET=CHANGE-ME-RUN-openssl-rand-hex-32
# 插件/MCP 凭据加密密钥（AES）。不设则回落 SERVER_SECRET；两者都缺时
# 兜底硬编码 dev key —— 属已知风险（#925 后续 hardening）。
# 注意：换 key 会让已加密保存的插件凭据无法解密（需重新录入）。
# REQUIRED — PLUGIN_ENCRYPTION_KEY=CHANGE-ME-RUN-openssl-rand-hex-32

# ── Authentication (username + password, bcrypt) ─────────────────────
JWT_EXPIRATION_HOURS=24

# ── CORS ─────────────────────────────────────────────────────────────
# Add your deployment hostname; * allows any origin (dev only).
CORS_ALLOW_ORIGINS=https://1-2-3-4.nip.io

# ── API version gates ────────────────────────────────────────────────
# Increment when making breaking changes. Defaults to 1.
# API_VERSION=1

# ── LLM Gateway ─────────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# KIMI_API_KEY=   # Moonshot AI Kimi (DEFAULT_LLM_PROVIDER=kimi)
# DEEPSEEK_API_KEY=            # DEFAULT_LLM_PROVIDER=deepseek
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# ── 分层模型映射(#925 补文档) — 中转站/自选模型时按需设置 ────────────────
# 网关按 tier(fast/premium/reasoner)选模型;默认随 provider 内置。
# 通用 tier 覆盖(优先于 provider 专属变量):
# LLM_MODEL_FAST=deepseek-v4-flash
# LLM_MODEL_PREMIUM=deepseek-v4-flash
# LLM_MODEL_REASONER=deepseek-reasoner
# DeepSeek provider 专属映射:
# DEEPSEEK_CHAT_MODEL=deepseek-v4-flash      # 默认 deepseek-v4-flash
# DEEPSEEK_REASONER_MODEL=deepseek-reasoner  # reasoner tier 覆盖
# DEEPSEEK_PREMIUM_MODEL=deepseek-v4-flash   # premium tier 覆盖
# Gemini 侧视觉模型(附件/公式 OCR 用;默认 gemini-2.0-flash):
# GEMINI_VISION_MODEL=gemini-2.0-flash
# 成本仪表盘单价覆盖($/1M tokens;JSON map,模型名→{input,output}):
# LLM_PRICING={"deepseek-v4-flash":{"input":0.5,"output":1.5}}
# 内置模型价目缺失时的兜底单价(默认 1.0 / 3.0):
# LLM_DEFAULT_INPUT_PRICE_PER_1M=1.0
# LLM_DEFAULT_OUTPUT_PRICE_PER_1M=3.0
# PubMed E-utilities API key(#835) — 免费注册 https://account.ncbi.nlm.nih.gov/settings/
# 生成;无 key 限 3 req/s(代码节流至 2.5 req/s),配 key 后 10 req/s(节流 8 req/s)。
# NCBI_API_KEY=
# 外部学术源 polite pool 联系邮箱(#835/#852) — 自动附加到请求(mailto/email 参数),
# 进入对方礼貌池:限流更宽松、出问题可被联系而非封禁。注意:邮箱会出现在请求 URL 中,
# 请用服务邮箱(如 no-reply@),勿用私人邮箱。不设也能用(走公共限流)。
# OPENALEX_MAILTO=no-reply@heurion.org
# CROSSREF_MAILTO=no-reply@heurion.org
# UNPAYWALL_EMAIL=no-reply@heurion.org
# LLM_TIMEOUT_MS=180000        # LLM 请求超时(首字节),默认 300s;doc 会话长生成放宽到 600s(LLM_DOC_TIMEOUT_MS)
# ── 回合可靠性兜底 (#828/#829/#830) ───────────────────────────────
# TOOL_TIMEOUT_MS=120000        # 单工具挂死兜底(长工具按映射放宽:spawn_subagent 600s/delegate 360s 等)
# TURN_MAX_MS=900000            # 回合总时长 watchdog,默认 15min — 超时发可解释错误并中止
# LLM_BODY_IDLE_TIMEOUT_MS=120000 # LLM 响应头到达后 body/流的空闲超时(防中转站发完头后 stall 无限挂)
# SUBAGENT_CONCURRENCY=3        # spawn_subagent 批量扇出并发上限(1-6)
# ── PDF 公式视觉 OCR (#698 文档化) ─────────────────────────────────
# PDF 导入时把前 N 页渲染成图用视觉模型提取公式转 LaTeX;每页一次视觉调用。
# PDF_FORMULA_OCR=1            # '0' 关闭(省视觉调用成本,公式段为空)
# PDF_FORMULA_OCR_MAX_PAGES=10 # 只处理前 N 页
# PDF_FORMULA_OCR_CONCURRENCY=3 # 并行视觉调用数
# ── 意图语义路由 (#585) ─────────────────────────────────────────────
# off(默认): 纯 LLM 裁决;shadow: 语义层只探测并入库(分歧率 <5% + recall ≥90%
# + p50 <50ms 达标后切 on);on: 高置信 generate/veto 零 LLM 直通,uncertain 回落 LLM。
# 月报: tsx scripts/semantic-router-eval.ts --report
# INTENT_SEMANTIC_ROUTER=off

# ── Embedding ──────────────────────────────────────────────────────
# Uses Transformers.js (ONNX) via the `nexus-embedding-server` container.
# To use OpenAI embeddings instead, set EMBEDDING_PROVIDER=openai and
# provide OPENAI_API_KEY above.
EMBEDDING_PROVIDER=local
# #796: keep the model consistent with the rest of the deployment —
# switching models changes the vector dimension (bge-small 384 vs bge-m3
# 1024) and silently breaks semantic retrieval; a switch requires re-indexing.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BATCH_SIZE=32
EMBEDDING_FALLBACK_PROVIDER=none          # openai or none
# #925: 必须指向 compose 内的 embedding 容器(localhost 在 nexus-server 容器里不是宿主机!)。
# 本机裸跑 server(非 compose)才改回 http://localhost:8003/embed。
LOCAL_EMBEDDING_URL=http://nexus-embedding-server:8003/embed
# EMBEDDING_DEVICE=cpu                     # cpu | cuda | mps | wasm (embedding server)
# EMBEDDING_QUANTIZED=0                    # 1 to enable INT8 quantized weights (smaller, slightly lower quality)
# EMBEDDING_DTYPE=                         # fp32 | fp16 | int8; leave empty for model default
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Execution Plane / Sidecar worker ────────────────────────────────
# Optional: URL of the Heurion worker VPS and shared auth token.
# EXECUTION_PLANE_URL=https://worker.heurion.org
# WORKER_API_TOKEN=dev-worker-token

# ── 邮件投递 (#925 补文档: 密码重置/邮箱验证) ──────────────────────────
# 不配 RESEND_API_KEY 时验证码只打进服务端日志(开发行为),生产等于找回密码不可用。
# RESEND_API_KEY=re_xxxxxxxxxxxx
# 发件人(默认 Heurion <no-reply@heurion.org>,自托管请改成自己的域名):
# EMAIL_FROM=Heurion <no-reply@your-domain.example>

# ── 可选外部服务 (#925 补文档) ────────────────────────────────────────
# 日历邮件中继(优先);不配则回落直连 SMTP(见下一组)。都不配则日历邀请邮件不可用。
# NEXUS_RELAY_URL=https://relay.example.com
# NEXUS_RELAY_API_KEY=xxx
# 直连 SMTP(nodemailer;与 relay 二选一):
# NEXUS_SMTP_HOST=smtp.example.com
# NEXUS_SMTP_USER=no-reply@your-domain.example
# NEXUS_SMTP_PASSWORD=xxx
# Agent 浏览器工具(Cloudflare Browser Rendering);不配则该工具返回明确错误:
# CLOUDFLARE_ACCOUNT_ID=xxx
# CLOUDFLARE_API_TOKEN=xxx
# 日志查询工具(log_query)读 Loki;默认 http://loki:3100(compose 未起 loki 时按实际拓扑改):
# LOKI_URL=http://loki:3100
# Evolution 队列走 Redis(BullMQ);不配则用进程内内存队列(重启丢任务):
# REDIS_URL=redis://redis:6379
# 期刊元数据动态富化(OpenAlex 等);=off 可关外呼(提交面板退回静态注册表):
# JOURNAL_DYNAMIC_DATA=off

# ── 后台任务 (#925 补文档: 默认行为,按需关/调) ─────────────────────────
# 知识 Gap 研究调度(默认 on,每 5min 一轮,消耗 LLM):
# GAP_RESEARCH_ENABLED=true
# GAP_RESEARCH_INTERVAL_MS=300000
# 轨迹→skill 提案归纳(默认 on,每 24h):
# SKILL_INDUCE_ENABLED=true
# SKILL_INDUCE_INTERVAL_MS=86400000
# 经验合成(默认 off,显式开启才跑;每 24h):
# EXPERIENCE_SYNTHESIS_ENABLED=false
# EXPERIENCE_SYNTHESIS_INTERVAL_MS=86400000
# Evolution worker(默认 on;仅在配置 REDIS_URL/BullMQ 时才有实际 worker):
# EVOLUTION_WORKER_ENABLED=true

# ── 上传/文件管线限额 (#925 补文档) ───────────────────────────────────
# UPLOAD_CHUNK_MAX_BYTES=32          # 单分片上限(MB),默认 32
# MAX_CHUNKED_UPLOAD_BYTES=2048      # 分片上传总上限(MB),默认 2048
# FILE_PIPELINE_MAX_BYTES=20971520   # 文件解析管线单文件上限(bytes),默认 20MB

# ── Tool execution (server runs tools on the agent's behalf) ─────────
# Web search via Tavily. Without this, agent's web_search tool returns
# "no API key" and agent has to fall back to URL reading.
TAVILY_API_KEY=
# Higher-quality URL extraction (free tier works without key).
JINA_API_KEY=


# ── Persistence (don't usually need to touch in Docker) ──────────────
# Defaults set inside the Dockerfile point at /data on the volume:
#   NEXUS_TWIN_BASE_DIR=/data/twins
#   UPLOAD_DIR=/data/uploads
#   NEXUS_CACHE_DIR=/data/cache
#   DATABASE_URL=sqlite:////data/db/nexus_server.db

# ── Rate limiting ────────────────────────────────────────────────────
# Per-user, per-minute. Tune if you have heavy usage. The "other"
# bucket covers everything except /llm/chat.
RATE_LIMIT_LLM_REQUESTS_PER_MINUTE=60
RATE_LIMIT_OTHER_REQUESTS_PER_MINUTE=120

# ── S3 Backup (#290) ─────────────────────────────────────────────
# S3-compatible object storage for off-site backups (MinIO/Spaces/B2/AWS).
# Leave empty to skip backup setup entirely.
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=heurion-backups
# BACKUP_RETAIN_DAYS=30
# BACKUP_RETAIN_WEEKS=8

# ── #fix 2026-09: 纯文本模型注册表覆盖 ──
# 中转站实际路由的模型可能不支持视觉(注册表按模型名假设)。
# 逗号分隔;命中后附件图片注入侧降级为文字占位,网关另有 400 自愈重试兜底。
# LLM_TEXT_ONLY_MODELS=deepseek-v4-flash
