# ─── Secrets / env (NEVER commit) ────────────────────────────────────
# Real keys go in .env (per package). Only .env.example is committed.
.env
.env.local
.env.production
.env.*.local
*.pem
*.key
keystore.json
wallet.json
mnemonic.txt
.secrets/

# Tesseract.js downloaded language data (auto-fetched at runtime)
*.traineddata

# Legacy Python virtual environment (pre-migration artifact)
.venv/

# ─── .NET / C# (legacy Avalonia desktop, git tag legacy/avalonia-final) ─
# Kept so a checkout of the legacy tag doesn't pollute working tree
# with bin/obj. The packages/desktop tree itself is no longer in main.
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
.vs/
*.sln.DotSettings.user
TestResults/
*.coverage
*.coveragexml

# ─── Node ────────────────────────────────────────────────────────────
node_modules/
package-lock.json
yarn.lock
# pnpm content-addressable store cache — must NEVER be committed
.pnpm-store/
# NOTE: pnpm-lock.yaml is intentionally NOT ignored — lockfiles are
# required for reproducible installs and MUST be committed.
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── IDE / editor ────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ─── OS junk ─────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Runtime state (regenerated on startup, sometimes contains user data) ─
# Server's per-user twin EventLog SQLite + curated memory + ABC contract state
.nexus_server/
~/.nexus_server/                     # belt-and-braces; user-specific
# Server-local dev DB / log
nexus_server.db
nexus_server.db-journal
nexus_server.db-wal
nexus_server.db-shm
nexus_server.log
# SDK/Nexus per-twin runtime caches (default base_dir variants)
.nexus/
.nexus_*/
.nexus_state/
.nexus_cache/
.nexus_demo/
# Legacy "rune" runtime caches (pre-Phase G — wipe on sight)
.rune_*/
.rune/

# Generic SQLite spill files
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# ─── Hardhat / Solidity (if contracts/ ever lands here) ──────────────
contracts/cache/
contracts/artifacts/
contracts/typechain/
contracts/typechain-types/

# ─── Misc temp / scratch ─────────────────────────────────────────────
*.tmp
*.bak
*.orig
*~
.test_*
.git_ignored_*
_attic/
scratch/
TODO.local.md
packages/server-ts/web-dist/
packages/server-ts/test-results/
packages/server-ts/playwright-report/

# ─── Playwright / E2E artifacts ────────────────────────────────────────
test-results/
playwright-report/
playwright/.cache/
*.png
screenshots/
# Brand assets in the web public folder must be tracked.
!packages/web/public/*.png
!packages/web/public/*.ico

# ─── Large generated / intermediate files ──────────────────────────────
*.map
*.tsbuildinfo
.eslintcache
.cache/

# ─── Production deploy artifacts (generated at build time) ─────────────
dist/
packages/server-ts/.env
